[resource]
script = ExtResource("1_6haco")
stage_script = ExtResource("2_nih50")
preview_scene_path = "res://demo/stages/stage_01/stage_01.tscn"
external_calls = PackedStringArray("arrive", "give:refused", "give:gift", "give:decoy", "relay:treat_out", "file:permit")
payload_fields = Array[ExtResource("4_payload")]([SubResource("GiftPayload"), SubResource("ReceiptPayload")])
managed_lifecycle = true
restoration_bindings = Array[ExtResource("5_binding")]([SubResource("PermitBinding"), SubResource("DuckBinding"), SubResource("BellBinding"), SubResource("GuardBinding"), SubResource("BellPoseBinding")])
call_positions = {
"arrive": Vector2(-150, 110),
"give:refused": Vector2(810, 345),
"give:gift": Vector2(810, 920),
"file:permit": Vector2(-140, 1140),
"give:decoy": Vector2(-150, 755),
"relay:treat_out": Vector2(-150, 530)
}
variables = [SubResource("Resource_pm6rk"), SubResource("Resource_crvuy"), SubResource("Resource_f6ula"), SubResource("Resource_cvxcv"), SubResource("delivered_duck"), SubResource("delivered_bell"), SubResource("gifts_delivered"), SubResource("citywide_deliveries")]
rules = [SubResource("Resource_4c63h"), SubResource("Resource_3q13q"), SubResource("Resource_8fm3u"), SubResource("Resource_v3yqw"), SubResource("Resource_gycwq"), SubResource("Resource_dw20m"), SubResource("Resource_w4bi3"), SubResource("Resource_j5n3i"), SubResource("Resource_og1qp"), SubResource("Resource_j8ley"), SubResource("Resource_cbhw2"), SubResource("Resource_42g1q"), SubResource("Resource_yo4ln"), SubResource("Resource_nqr6r"), SubResource("z1_bell_delivered"), SubResource("z1_missing_gift"), SubResource("z1_office_complete"), SubResource("z1_bell_receipt")]
groups = [SubResource("Resource_t3w14"), SubResource("Resource_6adl1"), SubResource("Resource_xb2ll"), SubResource("Resource_doyit")]
format_version = 4
